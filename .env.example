# Pegá tu API key real de OpenAI (nunca la subas al repo ni la pongas en la extensión)
OPENAI_API_KEY=sk-...

# Puerto del backend
PORT=3000

# Tamaño soportado por la API de generación (1024x1024, 1024x1536, 1536x1024)
IMAGE_SIZE=1024x1024

# Tamaño final de cada imagen entregada (el prompt maestro pide 1200x1200;
# como la API no genera ese tamaño de forma nativa, se reescala después)
OUTPUT_SIZE=1200

# Cuántas imágenes se generan en paralelo (cuidado con rate limits de OpenAI)
IMAGE_CONCURRENCY=3
