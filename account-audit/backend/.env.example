# Puerto del backend
PORT=3001

# --- OpenAI (capa de interpretación IA) ---
# Opcional: sin esta key, la app funciona igual usando explicaciones basadas en
# reglas (plantillas) en vez de texto generado por IA.
OPENAI_API_KEY=

# --- Mercado Libre (integración real, opcional) ---
# Creá una aplicación en https://developers.mercadolibre.com/ para obtener estas
# credenciales. Sin ellas, la app corre en modo demo con datos sembrados.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3001/api/ml/oauth/callback

# Ruta del archivo SQLite (se crea solo si no existe)
DB_PATH=./data/account-audit.db
